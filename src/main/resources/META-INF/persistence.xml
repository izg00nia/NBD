<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="default">

      <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

      <class>infrastructure.model.OrderedProductEnt</class>
      <class>infrastructure.model.FuelEnt</class>
      <class>infrastructure.model.GeneralItemEnt</class>
      <class>infrastructure.model.OrderEnt</class>
      <class>infrastructure.model.ProductEnt</class>

      <properties>
          <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
          <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/nbddb"/>
          <property name="jakarta.persistence.jdbc.user" value="nbd"/>
          <property name="jakarta.persistence.jdbc.password" value="nbdpassword"/>
          <property name="hibernate.hbm2ddl.auto" value="update"/>
          <property name="hibernate.connection.isolation" value="2"/>
      </properties>

  </persistence-unit>
</persistence>
